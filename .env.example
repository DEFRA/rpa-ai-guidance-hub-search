AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

AWS_BEARER_TOKEN_BEDROCK=dummy_token_for_bedrock
CLAUDE_SONNET_MODEL_CONFIG=anthropic.claude-sonnet-4-6,arn:aws:bedrock:eu-west-2:123456789012:application-inference-profile/fake-profile-test

FLOCI_ENDPOINT_URL=http://localhost:4566
SEARCH_STORE_S3_BUCKET=rpa-ai-guidance-hub-search-store
# Where the service unpacks the active index build; defaults under the temp dir.
#SEARCH_INDEX_DIRECTORY=/tmp/rpa-ai-guidance-hub-search
# `http` mounts the CMS ingestion routes; `s3` leaves them out.
#INGESTION_MODE=http
#MAX_INLINE_CONTENT_BYTES=2097152

REFERENCE_SCHEMES=basic-payment-scheme:Basic Payment Scheme,countryside-stewardship:Countryside Stewardship,not-specific:Not scheme-specific
REFERENCE_AUDIENCES=caseworker:Caseworker,customer:Customer
REFERENCE_SYSTEMS=siti-agri:Siti Agri,crm:CRM
REFERENCE_GUIDANCE_TYPES=process-guide:Process guide
