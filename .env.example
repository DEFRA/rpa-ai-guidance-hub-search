AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

FLOCI_ENDPOINT_URL=http://localhost:4566
SEARCH_STORE_S3_BUCKET=rpa-ai-guidance-hub-search-store
# The only bucket indexed content may be read from.
MANAGED_DOCS_S3_BUCKET=rpa-ai-guidance-hub-managed-docs
# Guide events to prepare, and jobs for the index's single writer (FIFO).
SEARCH_INDEXING_SQS_QUEUE_URL=http://localhost:4566/000000000000/rpa_ai_guidance_hub_search_indexing
SEARCH_INDEX_SYNC_SQS_QUEUE_URL=http://localhost:4566/000000000000/rpa_ai_guidance_hub_search_index_sync.fifo
# How long the queue consumers wait for messages in flight on shutdown, in seconds.
#SQS_SHUTDOWN_TIMEOUT_SECONDS=20
# Where the service unpacks the active index build; defaults under the temp dir.
#SEARCH_INDEX_DIRECTORY=/tmp/rpa-ai-guidance-hub-search
# How often each replica checks for a newer active build, in seconds.
#INDEX_REFRESH_INTERVAL_SECONDS=60
# `http` mounts the CMS ingestion routes; `s3` leaves them out.
#INGESTION_MODE=http

