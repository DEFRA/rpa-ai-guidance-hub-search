{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
      "cdp_filter": {
          "()": "app.common.log_utils.ExtraFieldsFilter"
      },
      "healthcheck_filter": {
          "()": "app.common.log_utils.EndpointFilter",
          "path": "/health"
      },
      "access_log_redaction": {
          "()": "app.common.log_utils.AccessLogRedactionFilter"
      }
  },
  "formatters": {
      "ecs": {
          "format": "%(message)s",
          "()": "ecs_logging.StdlibFormatter",
          "exclude_fields": [
              "color_message"
          ]
    }
  },
  "handlers": {
    "console": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout",
        "formatter": "ecs",
        "filters": ["healthcheck_filter", "cdp_filter"]
    }
  },
  "loggers": {
    "uvicorn.access": {
      "filters": ["access_log_redaction"]
    }
  },
  "root": {
      "level": "INFO",
      "handlers": ["console"],
      "propagate": "no"
  }
}
