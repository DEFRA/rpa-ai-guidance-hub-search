{
  "components": {
    "schemas": {
      "Accepted": {
        "description": "The request was accepted; the work happens after this reply.",
        "properties": {
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/Operation"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "versionId": {
            "format": "uuid",
            "title": "Versionid",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "versionId",
          "status",
          "operation"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "DocumentStatus": {
        "enum": [
          "ready_for_publish",
          "published"
        ],
        "title": "DocumentStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndexMetadata": {
        "description": "The CMS's metadata; `guideTitle` is required, and is the indexed title.",
        "properties": {
          "audience": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Audience",
            "type": "array"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "guidanceType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidancetype"
          },
          "guideTitle": {
            "minLength": 1,
            "title": "Guidetitle",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "requirements": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirements"
          },
          "schemeYear": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schemeyear"
          },
          "schemes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Schemes",
            "type": "array"
          },
          "systems": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Systems",
            "type": "array"
          }
        },
        "required": [
          "guideTitle"
        ],
        "title": "IndexMetadata",
        "type": "object"
      },
      "IndexRequest": {
        "description": "Index this published version. Exactly one of `contentUrl` or `content`.\n\nOnly `published` is accepted: the index holds one version per document, so\na version awaiting publication would replace the one readers can see.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InlineContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contenturl"
          },
          "metadata": {
            "$ref": "#/components/schemas/IndexMetadata"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "status": {
            "const": "published",
            "title": "Status",
            "type": "string"
          },
          "versionNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Versionnumber"
          }
        },
        "required": [
          "sourceType",
          "status",
          "occurredAt",
          "metadata"
        ],
        "title": "IndexRequest",
        "type": "object"
      },
      "InlineContent": {
        "description": "The version's `content.md`, and the API's `{anchor: sectionId}` map.",
        "properties": {
          "markdown": {
            "minLength": 1,
            "title": "Markdown",
            "type": "string"
          },
          "sectionIds": {
            "anyOf": [
              {
                "additionalProperties": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sectionids"
          }
        },
        "required": [
          "markdown"
        ],
        "title": "InlineContent",
        "type": "object"
      },
      "Operation": {
        "enum": [
          "index",
          "delete"
        ],
        "title": "Operation",
        "type": "string"
      },
      "SourceType": {
        "enum": [
          "guide"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RPA Guidance Hub Search API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/documents/{documentId}/versions/{versionId}": {
      "delete": {
        "description": "Remove this version, at every status, from the index and staged files.",
        "operationId": "delete_version_documents__documentId__versions__versionId__delete",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Documentid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "versionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Versionid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Version",
        "tags": [
          "ingestion"
        ]
      },
      "put": {
        "description": "Prepare this version, and index it if it is published.",
        "operationId": "index_version_documents__documentId__versions__versionId__put",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Documentid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "versionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Versionid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Inline content too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Index Version",
        "tags": [
          "ingestion"
        ]
      }
    }
  }
}
