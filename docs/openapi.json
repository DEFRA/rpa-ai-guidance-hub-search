{
  "components": {
    "schemas": {
      "Accepted": {
        "description": "The request was accepted; the work happens after this reply.",
        "properties": {
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "operation": {
            "$ref": "#/components/schemas/Operation"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "versionId": {
            "format": "uuid",
            "title": "Versionid",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "versionId",
          "status",
          "operation"
        ],
        "title": "Accepted",
        "type": "object"
      },
      "DocumentResult": {
        "description": "One document holding the words, with its best sections.",
        "properties": {
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "documentTitle": {
            "title": "Documenttitle",
            "type": "string"
          },
          "sectionTotal": {
            "description": "Every matching section in the document, not just those given",
            "title": "Sectiontotal",
            "type": "integer"
          },
          "sections": {
            "description": "At most `sections` of them, best first",
            "items": {
              "$ref": "#/components/schemas/SectionResult"
            },
            "title": "Sections",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "url": {
            "description": "Where a reader views the document",
            "title": "Url",
            "type": "string"
          },
          "versionId": {
            "format": "uuid",
            "title": "Versionid",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "documentTitle",
          "versionId",
          "status",
          "url",
          "sectionTotal",
          "sections"
        ],
        "title": "DocumentResult",
        "type": "object"
      },
      "DocumentSearchResponse": {
        "description": "Word search with `group=document`: a page of documents, best first.",
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "queryId": {
            "title": "Queryid",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/DocumentResult"
            },
            "title": "Results",
            "type": "array"
          },
          "sectionTotal": {
            "description": "Every matching section, across every document",
            "title": "Sectiontotal",
            "type": "integer"
          },
          "tooManyMatches": {
            "default": false,
            "title": "Toomanymatches",
            "type": "boolean"
          },
          "total": {
            "description": "Every matching document, not just this page; 0 when there are too many matches",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "queryId",
          "total",
          "sectionTotal",
          "results"
        ],
        "title": "DocumentSearchResponse",
        "type": "object"
      },
      "DocumentStatus": {
        "enum": [
          "ready_for_publish",
          "published"
        ],
        "title": "DocumentStatus",
        "type": "string"
      },
      "Grouping": {
        "enum": [
          "document"
        ],
        "title": "Grouping",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndexMetadata": {
        "description": "The CMS's metadata; `guideTitle` is required, and is the indexed title.",
        "properties": {
          "audience": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Audience",
            "type": "array"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          },
          "guidanceType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guidancetype"
          },
          "guideTitle": {
            "minLength": 1,
            "title": "Guidetitle",
            "type": "string"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "requirements": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirements"
          },
          "schemeYear": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schemeyear"
          },
          "schemes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Schemes",
            "type": "array"
          },
          "systems": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Systems",
            "type": "array"
          }
        },
        "required": [
          "guideTitle"
        ],
        "title": "IndexMetadata",
        "type": "object"
      },
      "IndexRequest": {
        "description": "Index this published version. Exactly one of `contentUrl` or `content`.\n\nOnly `published` is accepted: the index holds one version per document, so\na version awaiting publication would replace the one readers can see.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InlineContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contenturl"
          },
          "metadata": {
            "$ref": "#/components/schemas/IndexMetadata"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "sourceType": {
            "$ref": "#/components/schemas/SourceType"
          },
          "status": {
            "const": "published",
            "title": "Status",
            "type": "string"
          },
          "versionNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Versionnumber"
          }
        },
        "required": [
          "sourceType",
          "status",
          "occurredAt",
          "metadata"
        ],
        "title": "IndexRequest",
        "type": "object"
      },
      "InlineContent": {
        "description": "The version's `content.md`, and the API's `{anchor: sectionId}` map.",
        "properties": {
          "markdown": {
            "minLength": 1,
            "title": "Markdown",
            "type": "string"
          },
          "sectionIds": {
            "anyOf": [
              {
                "additionalProperties": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sectionids"
          }
        },
        "required": [
          "markdown"
        ],
        "title": "InlineContent",
        "type": "object"
      },
      "Operation": {
        "enum": [
          "index",
          "delete"
        ],
        "title": "Operation",
        "type": "string"
      },
      "SectionResult": {
        "description": "One section holding the words, at its best-matching chunk.",
        "properties": {
          "anchor": {
            "description": "The section's fragment in the document",
            "title": "Anchor",
            "type": "string"
          },
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "documentTitle": {
            "title": "Documenttitle",
            "type": "string"
          },
          "exact": {
            "description": "False for a near (typo-tolerant) match",
            "title": "Exact",
            "type": "boolean"
          },
          "heading": {
            "description": "The section's heading, or the document title before any section",
            "title": "Heading",
            "type": "string"
          },
          "headingPath": {
            "items": {
              "type": "string"
            },
            "title": "Headingpath",
            "type": "array"
          },
          "id": {
            "description": "The section ID",
            "title": "Id",
            "type": "string"
          },
          "matches": {
            "title": "Matches",
            "type": "integer"
          },
          "sectionNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sectionnumber"
          },
          "snippet": {
            "items": {
              "$ref": "#/components/schemas/SnippetPart"
            },
            "title": "Snippet",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "url": {
            "description": "Deep link to the section: the document's URL and its anchor",
            "title": "Url",
            "type": "string"
          },
          "versionId": {
            "format": "uuid",
            "title": "Versionid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "documentId",
          "documentTitle",
          "versionId",
          "status",
          "sectionNumber",
          "heading",
          "headingPath",
          "anchor",
          "url",
          "exact",
          "matches",
          "snippet"
        ],
        "title": "SectionResult",
        "type": "object"
      },
      "SnippetPart": {
        "properties": {
          "match": {
            "title": "Match",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "match"
        ],
        "title": "SnippetPart",
        "type": "object"
      },
      "SourceType": {
        "enum": [
          "guide"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "TitleResult": {
        "properties": {
          "documentId": {
            "format": "uuid",
            "title": "Documentid",
            "type": "string"
          },
          "documentTitle": {
            "title": "Documenttitle",
            "type": "string"
          },
          "score": {
            "description": "0 to 1; closer titles score higher",
            "title": "Score",
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "url": {
            "description": "Where a reader views the document",
            "title": "Url",
            "type": "string"
          },
          "versionId": {
            "format": "uuid",
            "title": "Versionid",
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "documentTitle",
          "versionId",
          "status",
          "url",
          "score"
        ],
        "title": "TitleResult",
        "type": "object"
      },
      "TitleSearchResponse": {
        "properties": {
          "queryId": {
            "title": "Queryid",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TitleResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "queryId",
          "results"
        ],
        "title": "TitleSearchResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WordSearchResponse": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "queryId": {
            "title": "Queryid",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SectionResult"
            },
            "title": "Results",
            "type": "array"
          },
          "tooManyMatches": {
            "default": false,
            "title": "Toomanymatches",
            "type": "boolean"
          },
          "total": {
            "description": "Every matching section, not just this page",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "queryId",
          "total",
          "results"
        ],
        "title": "WordSearchResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RPA Guidance Hub Search API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/documents/{documentId}/versions/{versionId}": {
      "delete": {
        "description": "Remove this version, at every status, from the index and staged files.",
        "operationId": "delete_version_documents__documentId__versions__versionId__delete",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Documentid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "versionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Versionid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Version",
        "tags": [
          "ingestion"
        ]
      },
      "put": {
        "description": "Prepare this version, and index it if it is published.",
        "operationId": "index_version_documents__documentId__versions__versionId__put",
        "parameters": [
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Documentid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "versionId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Versionid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Inline content too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Index Version",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/search": {
      "get": {
        "description": "Give exactly one of `q` (word search) or `title` (title search).",
        "operationId": "search_v1_search_get",
        "parameters": [
          {
            "description": "Words to find, like Word's Find: any case, anywhere in a word, several words as one phrase",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words to find, like Word's Find: any case, anywhere in a word, several words as one phrase",
              "title": "Q"
            }
          },
          {
            "description": "A title to look up",
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 500,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A title to look up",
              "title": "Title"
            }
          },
          {
            "description": "A document or version ID to search inside",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A document or version ID to search inside",
              "title": "Tag"
            }
          },
          {
            "description": "`document` answers word search with a page of documents, each with its best sections; `limit` and `offset` then count documents",
            "in": "query",
            "name": "group",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Grouping"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`document` answers word search with a page of documents, each with its best sections; `limit` and `offset` then count documents",
              "title": "Group"
            }
          },
          {
            "description": "With `group=document`: how many of each document's sections to give, best first",
            "in": "query",
            "name": "sections",
            "required": false,
            "schema": {
              "default": 3,
              "description": "With `group=document`: how many of each document's sections to give, best first",
              "maximum": 20,
              "minimum": 1,
              "title": "Sections",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WordSearchResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DocumentSearchResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TitleSearchResponse"
                    }
                  ],
                  "title": "Response Search V1 Search Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search documents by words, or by title",
        "tags": [
          "search"
        ]
      }
    }
  }
}
