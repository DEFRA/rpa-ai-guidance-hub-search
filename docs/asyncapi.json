{
  "asyncapi": "3.0.0",
  "channels": {
    "indexing": {
      "address": "rpa_ai_guidance_hub_search_indexing",
      "bindings": {
        "sqs": {
          "bindingVersion": "0.2.0",
          "deadLetterQueue": {
            "fifoQueue": false,
            "name": "rpa_ai_guidance_hub_search_indexing-deadletter"
          },
          "queue": {
            "fifoQueue": false,
            "name": "rpa_ai_guidance_hub_search_indexing",
            "redrivePolicy": {
              "deadLetterQueue": {
                "name": "rpa_ai_guidance_hub_search_indexing-deadletter"
              },
              "maxReceiveCount": 3
            },
            "visibilityTimeout": 60
          }
        }
      },
      "description": "A standard SQS queue. A message that fails is received again after 60 seconds, and dead-lettered after 3 receives. An event of a type search doesn't read is acknowledged and ignored.",
      "messages": {
        "guideVersionDeletedV1": {
          "$ref": "#/components/messages/guideVersionDeletedV1"
        },
        "guideVersionPublishedV1": {
          "$ref": "#/components/messages/guideVersionPublishedV1"
        }
      },
      "title": "Indexing queue"
    }
  },
