{
  "asyncapi": "3.0.0",
  "channels": {
    "indexSync": {
      "address": "rpa_ai_guidance_hub_search_index_sync.fifo",
      "bindings": {
        "sqs": {
          "bindingVersion": "0.2.0",
          "deadLetterQueue": {
            "fifoQueue": true,
            "name": "rpa_ai_guidance_hub_search_index_sync-deadletter.fifo"
          },
          "queue": {
            "deduplicationScope": "queue",
            "fifoQueue": true,
            "fifoThroughputLimit": "perQueue",
            "name": "rpa_ai_guidance_hub_search_index_sync.fifo",
            "redrivePolicy": {
              "deadLetterQueue": {
                "name": "rpa_ai_guidance_hub_search_index_sync-deadletter.fifo"
              },
              "maxReceiveCount": 3
            },
            "visibilityTimeout": 60
          }
        }
      },
      "description": "Work for the index's single writer, internal to search. One message group (`index-writer`); deduplicated by event `id`. Dead-lettered after 3 receives.",
      "messages": {
        "guideVersionPreparedV1": {
          "$ref": "#/components/messages/guideVersionPreparedV1"
        },
        "guideVersionRemovalRequestedV1": {
          "$ref": "#/components/messages/guideVersionRemovalRequestedV1"
        }
      },
      "title": "Index sync queue"
    },
    "indexing": {
      "address": "rpa_ai_guidance_hub_search_indexing",
      "bindings": {
        "sqs": {
          "bindingVersion": "0.2.0",
          "deadLetterQueue": {
            "fifoQueue": false,
            "name": "rpa_ai_guidance_hub_search_indexing-deadletter"
          },
          "queue": {
            "fifoQueue": false,
            "name": "rpa_ai_guidance_hub_search_indexing",
            "redrivePolicy": {
              "deadLetterQueue": {
                "name": "rpa_ai_guidance_hub_search_indexing-deadletter"
              },
              "maxReceiveCount": 3
            },
            "visibilityTimeout": 60
          }
        }
      },
      "description": "Guide events from the hub. Unknown event types are ignored. Dead-lettered after 3 receives.",
      "messages": {
        "guideVersionDeletedV1": {
          "$ref": "#/components/messages/guideVersionDeletedV1"
        },
        "guideVersionPublishedV1": {
          "$ref": "#/components/messages/guideVersionPublishedV1"
        }
      },
      "title": "Indexing queue"
    }
  },
