  "defaultContentType": "application/cloudevents+json",
  "info": {
    "description": "Guide events the search service indexes. They are the hub's events, not search's: rpa-ai-guidance-hub-api will publish them to its guide-events topic, which delivers them to the indexing queue, and until it does, search's own ingestion routes send the same events. Each message is a CloudEvents 1.0 event in structured JSON mode; `source` names whichever service sent it. Within v1, changes are additive and readers ignore what they don't know; a breaking change to `data` is a new schema, whose URN `dataschema` names (`\u2026:v2`).",
    "title": "RPA AI Guidance Hub search: indexing events",
    "version": "1.0.0"
  },
  "operations": {
    "receiveIndexingEvent": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/indexing"
      },
      "messages": [
        {
          "$ref": "#/channels/indexing/messages/guideVersionPublishedV1"
        },
        {
          "$ref": "#/channels/indexing/messages/guideVersionDeletedV1"
        }
      ],
      "summary": "The preparation worker prepares or removes each version."
    },
    "sendIndexingEvent": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/indexing"
      },
      "messages": [
        {
          "$ref": "#/channels/indexing/messages/guideVersionPublishedV1"
        },
        {
          "$ref": "#/channels/indexing/messages/guideVersionDeletedV1"
        }
      ],
      "summary": "Search's ingestion routes send an event for each request, until the API publishes them."
    }
  }
